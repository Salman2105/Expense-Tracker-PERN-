{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "npx prisma generate && npx prisma migrate deploy && npx prisma db seed && node server.js",
    "dev": "nodemon server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:seed": "npx prisma db seed",
    "prisma:push": "npx prisma db push",
    "prisma:setup": "cross-env PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION=yes npx prisma db push --accept-data-loss && npx prisma generate",
    "test": "jest --runInBand",
    "lint": "eslint ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "description": "Expense Tracker backend",
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "@scarf/scarf@1.4.0": true,
    "unrs-resolver@1.12.2": true
  }
}
