DATABASE_URL=
JWT_SECRET=
NODE_ENV=production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
PORT=3000
LOG_LEVEL=info

# Optional SMTP configuration for budget notification emails.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Backend-only Cloudinary credentials. Never expose these in frontend env files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=